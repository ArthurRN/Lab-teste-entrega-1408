{
  "name": "lab-teste-entrega",
  "version": "1.0.0",
  "description": "Exercicio de fixacao - calcularTaxaEntrega (EP/BVA + Jest + ISO 29119)",
  "main": "taxaEntrega.js",
  "scripts": {
    "test": "jest --verbose",
    "test:coverage": "jest --coverage",
    "test:report": "jest --reporters=default --reporters=jest-html-reporter"
  },
  "keywords": ["jest", "iso29119", "software-testing"],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "jest": "^29.7.0",
    "jest-html-reporter": "^3.10.2"
  },
  "jest": {
    "reporters": [
      "default",
      [
        "jest-html-reporter",
        {
          "pageTitle": "Relatório de Teste de Software - ISO 29119 (Taxa de Entrega)",
          "outputPath": "./relatorio-testes.html",
          "includeFailureMsg": true
        }
      ]
    ]
  }
}